# EMS Agent Environment Configuration
# Copy this file to .env and update with your values

# ===================================
# Database Configuration
# ===================================
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=EMS_Database
MONGODB_COLLECTION=energy_data

# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# ===================================
# Redis Configuration
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================================
# Application Configuration
# ===================================
ENVIRONMENT=development
MICROSERVICES_MODE=true
DEBUG=true
LOG_LEVEL=INFO

# Service Ports
API_GATEWAY_PORT=8000
DATA_INGESTION_PORT=8001
ANALYTICS_PORT=8002
QUERY_PROCESSOR_PORT=8003
NOTIFICATION_PORT=8004

# ===================================
# Security Configuration
# ===================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ADMIN_PASSWORD=admin123
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===================================
# Machine Learning Configuration
# ===================================
ML_MODEL_PATH=models/
ANOMALY_THRESHOLD=0.8
PREDICTION_WINDOW_HOURS=24

# ===================================
# Monitoring & Observability
# ===================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
METRICS_RETENTION_DAYS=30

# ===================================
# Notification Services
# ===================================
# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@sustainabyte.com

# Slack Configuration (Optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#energy-alerts

# SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===================================
# Third-party Integrations
# ===================================
# Gemini AI API Key (for advanced analytics)
GEMINI_API_KEY=your-gemini-api-key

# Weather API (for external data correlation)
WEATHER_API_KEY=your-weather-api-key

# ===================================
# Performance & Scaling
# ===================================
MAX_WORKERS=4
BATCH_SIZE=1000
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# ===================================
# Development Settings
# ===================================
# Enable/disable features for development
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false
MOCK_EXTERNAL_SERVICES=false

# Test Configuration
TEST_DATABASE=EMS_Test_Database
RUN_INTEGRATION_TESTS=false
